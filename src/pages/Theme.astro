---
// src/components/ThemeToggle.astro
---

<button
  id="theme-toggle"
  type="button"
  class="relative z-[100] p-2 rounded-lg bg-gray-100 dark:bg-slate-800 border border-gray-300 dark:border-slate-700 hover:bg-gray-200 dark:hover:bg-slate-700 transition-colors"
  aria-label="Cambiar Tema"
>
  <span id="theme-toggle-light-icon" class="hidden dark:hidden text-orange-500">
    ☀️
  </span>
  <span id="theme-toggle-dark-icon" class="hidden dark:inline text-blue-400">
    🌙
  </span>
</button>

<script>
  const setupTheme = () => {
    // 1. Lógica para obtener el tema (localStorage o preferencia del sistema)
    const theme = (() => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        return localStorage.getItem('theme');
      }
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        return 'dark';
      }
      return 'light';
    })();

    // 2. Aplicar la clase 'dark' al <html>
    if (theme === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }

    // 3. Guardar en localStorage para persistir
    window.localStorage.setItem('theme', theme);

    // 4. Actualizar los iconos del botón
    const lightIcon = document.getElementById('theme-toggle-light-icon');
    const darkIcon = document.getElementById('theme-toggle-dark-icon');

    if (theme === 'dark') {
      lightIcon?.classList.add('hidden');
      darkIcon?.classList.remove('hidden');
    } else {
      lightIcon?.classList.remove('hidden');
      darkIcon?.classList.add('hidden');
    }

    // 5. Configurar el evento de click (solo si no se ha configurado antes)
    const button = document.getElementById("theme-toggle");
    
    // Remover listener anterior para evitar duplicados en ViewTransitions
    button?.removeEventListener("click", handleToggleClick);
    button?.addEventListener("click", handleToggleClick);
  };

  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle("dark");

    const isDark = element.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    
 
    setupTheme();
  };

 
  setupTheme();

 
  document.addEventListener('astro:after-swap', setupTheme);
</script>