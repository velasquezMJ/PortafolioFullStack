>
  <div class="text-blue-600 dark:text-blue-400 mb-3 flex justify-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
  </div>
  <h3 class="font-bold text-gray-900 dark:text-white">Email</h3>
  <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Click para copiar</p>
  <p class="text-[10px] text-blue-500 mt-2 opacity-0 group-hover:opacity-100 transition-opacity">Haz clic para copiar</p>
</div>

      <a href="https://linkedin.com/in/mario-velasquez-5a13b8140" target="_blank" class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 hover:border-blue-700 dark:hover:border-blue-500 transition-all group">
        <div class="text-blue-700 dark:text-blue-500 mb-3 flex justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </div>
        <h3 class="font-bold text-gray-900 dark:text-white">LinkedIn</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Conecta conmigo</p>
      </a>

      <a href="https://wa.me/50497139610" target="_blank" class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 hover:border-green-500 dark:hover:border-green-400 transition-all group">
        <div class="text-green-600 dark:text-green-500 mb-3 flex justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
