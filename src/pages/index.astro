      "Infraestructura sobre Debian gestionada con PM2 y Nginx."
    ],
    tech: ["Angular", "Node.js", "MariaDB", "Ionic", "Socket.io"],
    link: "https://guardianxhn.com/",  
    linkText: "Ver Proyecto"
  },
  {
    titulo: "Fundación Azteca Honduras",
    badge: "Sitio Oficial",
    badgeColor: "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400",
    descripcion: "Plataforma institucional robusta diseñada para la gestión dinámica de contenidos y proyectos sociales.",
    puntos: [
      "Arquitectura híbrida: PHP (público) y Angular/Node.js (administrativo).",
      "CMS 100% administrable para actualización oportuna de secciones.",
      "Optimización de rendimiento y SEO para presencia institucional.",
      "Gestión de flujos de datos escalables para alta demanda."
    ],
    tech: ["Angular", "Node.js", "PHP", "MySQL", "Cloud Hosting"],
    link: "https://fundacionazteca.com.hn/",
    linkText: "Visitar Sitio"
  },
  {
    titulo: "ERP & Facturación Electrónica",
    badge: "Uso Interno",
    badgeColor: "bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400",
    descripcion: "Sistema integral para operaciones críticas, integrando flujos logísticos y financieros bajo estándares SAR.",
    puntos: [
      "Facturación Electrónica alineada a los estándares legales del SAR.",
      "Integración compleja con sistemas legacy AS400 y CORE Logístico.",
      "Gestión de procedimientos almacenados complejos en SQL Server.",
      "Módulos de Notas de Débito y mantenimiento de facturación masiva."
    ],
    tech: ["Angular", "Node.js", "SQL Server", "AS400", "SqlServers"],
    link: null, // No tiene link público
    linkText: null
  }
