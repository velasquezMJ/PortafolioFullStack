 ---
import Layout from './layouts/Layout.astro';
---

<Layout title="Guardian X">
  <section class="pt-32 pb-20 px-4 min-h-screen bg-gray-50 dark:bg-slate-950 transition-colors duration-300">
    
    <div class="max-w-lg mx-auto bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-2xl shadow-blue-900/10 dark:shadow-none border border-gray-100 dark:border-slate-800 overflow-hidden">
      
      <div class="p-8 md:p-12">
        <div class="text-center mb-10">
          <h1 class="text-3xl font-bold tracking-tight text-blue-900 dark:text-white">
            Hablemos de tu <span class="text-blue-600">Residencial</span>
          </h1>
          <p class="text-slate-500 dark:text-slate-400 mt-2 text-sm">
            Moderniza la gestión de tu comunidad hoy mismo.
          </p>
        </div>
    
        <form id="contact-form" method="POST" class="space-y-6">

          <div class="group space-y-1">
            <label for="nombre" class="text-xs font-semibold text-blue-900/40 dark:text-slate-500 uppercase tracking-widest ml-1 transition-colors group-focus-within:text-blue-600">Nombre</label>
            <input 
              type="text" name="nombre" id="nombre" placeholder="Ej. Juan Pérez" 
              class="w-full p-4 bg-blue-50/50 dark:bg-slate-800/50 border-none rounded-2xl focus:ring-2 focus:ring-blue-600/20 outline-none transition-all dark:text-white placeholder:text-slate-400" 
              required 
            />
          </div>

             <div class="group space-y-1">
            <label for="nombre Residencial" class="text-xs font-semibold text-blue-900/40 dark:text-slate-500 uppercase tracking-widest ml-1 transition-colors group-focus-within:text-blue-600">Nombre Residencial</label>
            <input 
              type="text" name="nombreResidencial" id="nombreResidencial" placeholder="Res. Miramontes" 
              class="w-full p-4 bg-blue-50/50 dark:bg-slate-800/50 border-none rounded-2xl focus:ring-2 focus:ring-blue-600/20 outline-none transition-all dark:text-white placeholder:text-slate-400" 
              required 
            />
          </div>

            <div class="group space-y-1">
            <label for="Cantidad Casas" class="text-xs font-semibold text-blue-900/40 dark:text-slate-500 uppercase tracking-widest ml-1 transition-colors group-focus-within:text-blue-600">Cantidad de casas</label>
            <input 
              type="number" name="CantidadCasas" id="cantidadCasas" placeholder="20" 
              class="w-full p-4 bg-blue-50/50 dark:bg-slate-800/50 border-none rounded-2xl focus:ring-2 focus:ring-blue-600/20 outline-none transition-all dark:text-white placeholder:text-slate-400" 
              required 
            />
          </div>

          <div class="group space-y-1">
            <label for="email" class="text-xs font-semibold text-blue-900/40 dark:text-slate-500 uppercase tracking-widest ml-1 transition-colors group-focus-within:text-blue-600">Correo</label>
            <input 
              type="email" name="email" id="email" placeholder="juan@residencial.com" 
              class="w-full p-4 bg-blue-50/50 dark:bg-slate-800/50 border-none rounded-2xl focus:ring-2 focus:ring-blue-600/20 outline-none transition-all dark:text-white placeholder:text-slate-400" 
              required 
            />
          </div>

          <div class="group space-y-1">
            <label for="mensaje" class="text-xs font-semibold text-blue-900/40 dark:text-slate-500 uppercase tracking-widest ml-1 transition-colors group-focus-within:text-blue-600">Mensaje</label>
            <textarea 
              name="mensaje" id="mensaje" placeholder="¿En qué podemos ayudarte?" 
              class="w-full p-4 bg-blue-50/50 dark:bg-slate-800/50 border-none rounded-2xl focus:ring-2 focus:ring-blue-600/20 outline-none transition-all dark:text-white placeholder:text-slate-400 h-32 resize-none"
            ></textarea>
          </div>
          
          <button
            id="submit-btn"
            type="submit"
            class="w-full py-4 bg-blue-600 text-white rounded-2xl font-bold tracking-wide cursor-pointer transition-all hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-600/30 active:scale-[0.98]"
          >
            Enviar Mensaje
          </button>
        </form>
      </div>
    </div>
  </section>

  <script> 
    import Swal from 'sweetalert2';

    const form = document.getElementById('contact-form') as HTMLFormElement;
    
 form.addEventListener('submit', async (e) => {
    e.preventDefault(); // Detenemos el envío tradicional

    // --- ESTA ES LA LÍNEA QUE TE FALTA ---
    const formData = new FormData(e.target); 
    // -------------------------------------

    // Ahora ya puedes convertirlo a objeto
    const data = Object.fromEntries(formData);

    // Preparamos el body para tu API de Guardian X
    const bodyPayload = {
        Nombre: data.nombre,        
        Residencial: data.nombreResidencial,
        Cantidad: data.CantidadCasas,
        Correo: data.email,
        Mensaje: data.mensaje || "Interesado en el sistema"
    };

 try {
    // 1. Mostramos un "Enviando..." para que el usuario sepa que algo pasa
    Swal.fire({
        title: 'Enviando...',
        text: 'Por favor espera un momento',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
    });

    const response = await fetch('https://guardianxhn.com/api-admin/api/dev/auth/EmailLanding', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(bodyPayload)
    });

    // 2. Cerramos el cargando y mostramos el éxito
    Swal.close(); 

    if (response.ok) {
        await Swal.fire({
            title: '¡Mensaje enviado!',
            text: 'Te contactaremos a la brevedad.',
            icon: 'success',
            confirmButtonText: 'Genial',
            confirmButtonColor: '#2563eb',
            customClass: {
                confirmButton: 'px-10 py-3 bg-blue-600 text-white rounded-xl font-bold cursor-pointer'
            }
        });
        form.reset();
    } else {
        throw new Error('Error en el servidor');
    }
} catch (error) {
    Swal.fire('Error', 'Hubo un problema al conectar con el servidor.', 'error');
}
});

  </script>
</Layout>