---
// src/layouts/Layout.astro
import ThemeToggle from '../Theme.astro';
import '../../styles/global.css';
import { Github, Linkedin, MessageCircle  } from 'lucide-astro';

interface Props {
  title: string;
}

const { title } = Astro.props;

const navItems = [
  { name: 'Inicio', href: '/#inicio' },
  { name: 'Sobre mí', href: '/#acerca' },
  { name: 'Habilidades', href: '/#habilidades' },  
  { name: 'Proyectos', href: '/#proyectos' },  
  { name: 'Contacto', href: '/#contacto' },
];

const socialLinks = [
  { name: 'Github', href: 'https://github.com/velasquezMJ', icon: Github }, 
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/mario-velasquez-5a13b8140/', icon: Linkedin },
  { name: 'Whatssap', href: 'https://wa.me/50497139610/', icon: MessageCircle },
  
];
 

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Portafolio" />
    <meta name="viewport" content="width=device-width" /> 
    <title>{title}</title>
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
    
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 transition-colors duration-300">
 <header class="fixed w-full z-50 top-0 start-0 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md border-b border-gray-200 dark:border-slate-800 transition-colors duration-300">
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
    
    <a href="/" class="flex items-center space-x-3"> 
      <span class="text-2xl font-bold text-blue-900 dark:text-white"> Mario Velasquez </span>
    </a>

    <div class="flex items-center md:order-2 space-x-4">
      <ThemeToggle />
      
      <button 
        id="menu-toggle" 
        type="button" 
        class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md:hidden hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-slate-800 focus:outline-none"
      >
        <span class="sr-only">Abrir menú</span>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>

    <div 
      id="navbar-menu" 
      class="hidden w-full md:flex md:w-auto md:order-1 items-center"
    >
      <ul class="flex flex-col p-4 md:p-0 mt-4 font-medium border border-gray-100 rounded-lg bg-gray-50 md:space-x-8 md:flex-row md:mt-0 md:border-0 md:bg-transparent dark:bg-slate-900 md:dark:bg-transparent dark:border-slate-800">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href} 
              class="block py-2 px-3 text-gray-700 dark:text-gray-300 font-medium hover:text-blue-700 dark:hover:text-blue-400 rounded md:bg-transparent md:p-0"
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </div> 
  </div>

 

</header>

    <main class="w-full">
      <slot />
    </main>

    <footer class="bg-gray-100 dark:bg-slate-950 border-t border-gray-200 dark:border-slate-800 mt-12 mb-8">
    
    <div class="flex justify-center space-x-6 mb-8 mt-8">
      {socialLinks.map((social) => (
        <a 
          href={social.href} 
          target="_blank"
          class="text-gray-500 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-300 transform hover:scale-110"
          aria-label={social.name}
        >
          {/* Renderizamos el componente del icono dinámicamente */}
          <social.icon class="w-6 h-6" />
        </a>
      ))}
    </div>
      
    </footer>
  </body>
</html>

<script is:inline>
  function setupMenu() {
    const menuBtn = document.getElementById('menu-toggle');
    const menu = document.getElementById('navbar-menu');
    const links = menu?.querySelectorAll('a');

    if (menuBtn && menu) {
      // Toggle al hacer click en el botón
      menuBtn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });

      // Cerrar menú al hacer click en cualquier link (para móviles)
      links?.forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
        });
      });
    }
  }

  // Ejecutar al cargar
  setupMenu();

  // Si usas ViewTransitions de Astro
  document.addEventListener('astro:after-swap', setupMenu);
</script>